{
  "ftef": "0.1",
  "vectors": [
    {
      "id": "6.1-best-item",
      "rule": "6.1",
      "description": "the band is the best counted item: attested on hardware-rooted binding gives high",
      "record": {
        "base": "examples/valid/partner-attested.json",
        "patch": [
          {
            "op": "remove",
            "path": "/evaluation"
          }
        ]
      },
      "policy": {
        "base": "examples/valid/policy-defaults.json"
      },
      "at": "2026-10-14T12:00:00Z",
      "situationLevel": "normal",
      "expect": {
        "band": "high",
        "evidencedBand": "high",
        "accepted": false,
        "limits": []
      }
    },
    {
      "id": "6.1-partial-scope",
      "rule": "6.1",
      "description": "partial scope lowers an item by one band",
      "record": {
        "base": "examples/valid/partner-attested.json",
        "patch": [
          {
            "op": "remove",
            "path": "/evidence/1"
          },
          {
            "op": "replace",
            "path": "/evidence/0/axes/scope",
            "value": "partial"
          },
          {
            "op": "remove",
            "path": "/evaluation"
          }
        ]
      },
      "policy": {
        "base": "examples/valid/policy-defaults.json"
      },
      "at": "2026-10-14T12:00:00Z",
      "situationLevel": "normal",
      "expect": {
        "band": "medium"
      }
    },
    {
      "id": "6.1-future-dated",
      "rule": "6.1",
      "description": "an item dated after the evaluation time counts as none",
      "record": {
        "base": "examples/valid/partner-attested.json",

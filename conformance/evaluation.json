          {
            "op": "remove",
            "path": "/evaluation"
          }
        ]
      },
      "policy": {
        "base": "examples/valid/policy-defaults.json"
      },
      "at": "2026-10-14T12:00:00Z",
      "situationLevel": "normal",
      "expect": {
        "band": "none"
      }
    },
    {
      "id": "6.1-state-cap",
      "rule": "6.1",
      "description": "the partner's state caps the band: restricted caps at low and carries its limits",
      "record": {
        "base": "examples/valid/partner-attested.json",
        "patch": [
          {
            "op": "add",
            "path": "/stateHistory/-",
            "value": {
              "state": "restricted",
              "since": "2026-10-14T10:00:00Z",
              "trigger": "confirmed security incident at the partner"
            }
          },
          {
            "op": "replace",
            "path": "/state",
            "value": "restricted"
          },
          {
            "op": "remove",
            "path": "/evaluation"
          }
        ]
      },
      "policy": {
        "base": "examples/valid/policy-defaults.json"
      },
      "at": "2026-10-14T12:00:00Z",
      "situationLevel": "normal",
      "expect": {
        "band": "low",
        "evidencedBand": "low",
        "limits": [
          {
            "type": "no-transit"
          },
          {
            "type": "no-automatic-actions"
          },
          {
            "type": "reduced-lease",
            "value": 0.5
          }
        ]
      }
    },
    {
      "id": "6.1-adverse-cancels",
      "rule": "6.1",
      "description": "an unresolved adverse item cancels supporting evidence about the same coverage",
      "record": {
        "base": "examples/valid/partner-attested.json",
        "patch": [
          {
            "op": "add",
            "path": "/evidence/-",
            "value": {
              "id": "ev-3",
              "class": "observed",
              "result": "adverse",
              "axes": {
                "source": "second-party",
                "timeBasis": "point-in-time",
                "binding": "signed",
                "scope": "full"
              },
              "issuer": {
                "id": "https://probe.vdhrelyingparty.example"
              },
              "issuedAt": "2026-10-14T08:00:00Z",
              "covers": "the partner service exposed at the federation seam (fictional)"
            }
          },
          {
            "op": "remove",
            "path": "/evaluation"
          }
        ]
      },
      "policy": {
        "base": "examples/valid/policy-defaults.json"
      },
      "at": "2026-10-14T12:00:00Z",
      "situationLevel": "normal",
      "expect": {
        "band": "none"
      }
    },

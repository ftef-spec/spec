{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftef.vdhome.be/conformance/vector.schema.json",
  "title": "FTEF conformance vectors (section 7.5)",
  "type": "object",
  "required": [
    "ftef",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "ftef": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "evaluation vector",
            "required": [
              "id",
              "rule",
              "description",
              "record",
              "policy",
              "at",
              "situationLevel",
              "expect"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-z.-]+$"
              },
              "rule": {
                "type": "string",
                "pattern": "^[0-9]+([.][0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "$ref": "#/$defs/ref"
              },
              "policy": {
                "$ref": "#/$defs/ref"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "situationLevel": {
                "type": "string"
              },
              "statusReachable": {
                "type": "boolean",
                "default": true
              },
              "expect": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "band": {
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "evidencedBand": {
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "accepted": {
                    "type": "boolean"
                  },
                  "limits": {
                    "type": "array"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "title": "validity vector",
            "required": [
              "id",
              "rule",
              "kind",
              "description",
              "document",
              "expect"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-z.-]+$"
              },
              "rule": {
                "type": "string",
                "pattern": "^[0-9]+([.][0-9]+)*$"
              },
              "kind": {
                "enum": [
                  "partner-record",
                  "policy",
                  "trust-mark"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "document": {
                "$ref": "#/$defs/ref"
              },
              "expect": {
                "type": "object",
                "required": [
                  "valid"
                ],
                "additionalProperties": false,
                "properties": {
                  "valid": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "base"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^examples/[a-z0-9./-]+[.]json$",
          "description": "A document in this repository, relative to its root."
        },
        "patch": {
          "type": "array",
          "description": "RFC 6902 JSON Patch operations applied to the base: add, remove, replace.",
          "items": {
            "type": "object",
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "remove",
                  "replace"
                ]
              },
              "path": {
                "type": "string"
              },
              "value": {}
            }
          }
        }
      }
    }
  }
}
